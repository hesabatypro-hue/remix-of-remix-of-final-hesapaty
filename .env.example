# ==========================================
# متغيرات البيئة للواجهة الأمامية (Vite Frontend)
# انسخ هذا الملف إلى .env محلياً (لن يُرفع لـ Git)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ==========================================
# أسرار دوال الحافة (Supabase Edge Functions Secrets)
# تضاف في: Supabase Dashboard -> Settings -> Configuration -> Edge Function Secrets
# أو عبر Supabase CLI: supabase secrets set KEY=VALUE
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# الذكاء الاصطناعي لتحليل الإشعارات (Lovable AI Gateway / Gemini 2.5 Flash)
LOVABLE_API_KEY=your-lovable-api-key

# ويبهوك Meta WhatsApp Cloud API
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-meta-webhook-verify-token

# ويبهوك Green-API (WhatsApp)
GREEN_API_WEBHOOK_SECRET=your-green-api-webhook-secret-token

# أمان المهام المجدولة (pg_cron & Retry Queue)
CRON_SECRET=your-internal-cron-secret
